# OPENAI_IMAGE_QUALITY=medium
# AI_FREE_IMAGES_PER_MONTH=3
# Encrypts creators' saved API keys (defaults to JWT_SECRET; set your own so rotating JWT_SECRET doesn't lose them)
# KEY_ENCRYPTION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
