APP_ENV=production
DB_NAME=dropforge
JWT_SECRET=change-me-long-random
CORS_ORIGINS=https://your-frontend-domain
EXPO_PUBLIC_BACKEND_URL=https://api.nexusagents.cloud
ADMIN_PHONES=
SUPPORT_CONTACT=
ANTHROPIC_API_KEY=
# AI PNG images (OpenAI gpt-image). Users get a few free per month, then buy credits; creators may bring their own key.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
# AI_FREE_IMAGES_PER_MONTH=3
# Encrypts creators' saved API keys (defaults to JWT_SECRET; set your own so rotating JWT_SECRET doesn't lose them)
# KEY_ENCRYPTION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 storage. Once set, new uploads go to R2 (old Cloudinary files keep working; scripts/migrate_to_r2.py moves them).
# R2_BUCKET has NO public access (artwork, backups). R2_PUBLIC_BUCKET + R2_PUBLIC_URL (its custom domain) serve shop photos directly.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dropforge-private
R2_PUBLIC_BUCKET=dropforge-public
R2_PUBLIC_URL=https://cdn.dropforge.in
# STORAGE_BACKEND=cloudinary   # force new uploads back to Cloudinary
BACKUP_KEEP_DAYS=30

# Push notifications (Expo push service). Only needed if 'enhanced push security' is enabled in the Expo project.
EXPO_ACCESS_TOKEN=

# Error monitoring (optional): Sentry project DSN
SENTRY_DSN=

# Email (optional): order updates + email verification. Set EMAIL_FROM and either RESEND_API_KEY or SMTP_*.
EMAIL_FROM=DropForge <orders@dropforge.in>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Public website address (used in email links)
SITE_URL=https://dropforge.in
